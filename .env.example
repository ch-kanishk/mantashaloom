# ---------- Core ----------
# Must match the origin you actually serve from — canonicals, OG tags and the
# sitemap are all built from it.
NEXT_PUBLIC_SITE_URL="https://www.mantashaloom.com"
NEXT_PUBLIC_SITE_NAME="Mantashaloom"

# ---------- Database (PostgreSQL) ----------
# DATABASE_URL is the pooled connection used by the app.
# DIRECT_URL is an unpooled connection used only for migrations — a transaction
# pooler cannot run them. With Neon/Vercel Postgres, use the "pooled" and
# "unpooled"/"direct" strings respectively. Without a pooler, set both the same.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ---------- Admin login ----------
ADMIN_EMAIL="admin@mantashaloom.com"
ADMIN_PASSWORD="change-me-to-something-long"
# 32+ random characters. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string-min-32-chars"

# ---------- Razorpay ----------
# Dashboard -> Account & Settings -> API Keys. Use test keys (rzp_test_...) until
# you are ready to take real payments, then switch both to the live pair.
# Leave empty on a local dev server to use the simulated payment page; a
# production build refuses checkout without them.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard -> Account & Settings -> Webhooks: the secret you set on the webhook.
RAZORPAY_WEBHOOK_SECRET=""

# ---------- Image uploads ----------
# Set automatically when you attach a Vercel Blob store to the project.
# Left empty locally, uploads fall back to public/uploads on disk.
# BLOB_READ_WRITE_TOKEN=""
# On Hostinger or any long-running server: an absolute path OUTSIDE the app
# folder, so uploads survive redeploys. Served at /uploads/<file>.
# UPLOAD_DIR="/home/<user>/mantashaloom-uploads"

# ---------- Store ----------
STORE_CURRENCY="INR"
FREE_SHIPPING_ABOVE="15000"
FLAT_SHIPPING_FEE="499"
GST_PERCENT="12"
